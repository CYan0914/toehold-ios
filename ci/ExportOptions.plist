<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- `app-store-connect` rather than the older `app-store`. Xcode renamed
	     the method in 15.3 and the old spelling is on its way out; the failure
	     mode is an export that refuses an otherwise-valid archive. -->
	<key>method</key>
	<string>app-store-connect</string>

	<!-- Upload straight from the export rather than writing an .ipa to the
	     runner and posting it afterwards. One fewer artefact to lose, and the
	     credential that signed the archive is the one that uploads it. -->
	<key>destination</key>
	<string>upload</string>

	<key>teamID</key>
	<string>H4VQ9X6KYK</string>

	<!-- Manual signing, with the profile named below.

	     Automatic signing does not work on a CI runner. It does not adopt a
	     profile that already exists in the account; it asks the cloud signing
	     service to mint one, and when that service declines, the error blames
	     the bundle id:

	         Cloud signing permission error
	         No profiles for 'com.cyan0914.toehold' were found

	     Neither line is true, which is what makes it expensive to debug: the
	     profile exists, and the key that made it can manage profiles. Naming
	     the profile explicitly takes the signing service out of the path.

	     Toehold makes this worse than it is for most apps, and that is worth
	     knowing before debugging a signing failure. The profile carries an
	     iCloud container, so a profile that is merely stale is not a valid
	     profile: enabling iCloud in the portal does not update an existing
	     profile, and a profile minted before the container existed signs the
	     archive and then produces an app that never syncs and reports no
	     error anywhere. -->

	<!-- Kept as documentation, not as input. The workflow generates the real
	     ExportOptions at build time with the profile name it actually
	     installed, so the name here cannot drift from the one in use.

	     Toehold App Store
	     iCloud.com.cyan0914.toehold -->
	<key>signingStyle</key>
	<string>manual</string>

	<key>provisioningProfiles</key>
	<dict>
		<key>com.cyan0914.toehold</key>
		<string>Toehold App Store</string>
	</dict>

	<key>uploadSymbols</key>
	<true/>

	<!-- The version and build number are owned by project.yml, which is
	     reviewable in a diff. Letting the exporter pick its own build number
	     means the number that reaches App Store Connect is decided inside a
	     black box, and the next upload collides with it. -->
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
</dict>
</plist>
